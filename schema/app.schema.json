{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/khalid-tounoussi-1/mcp-apps/main/schema/app.schema.json",
  "title": "MCP App entry",
  "description": "One MCP server that ships an interactive UI via the io.modelcontextprotocol/ui extension. Source of truth lives in apps/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "repo_url", "category", "verification"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Kebab-case. MUST equal the filename without .json."
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "One sentence saying what the user can do with it. Name the interaction."
    },
    "repo_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "author": { "type": "string", "maxLength": 80 },
    "license": { "type": "string", "maxLength": 40 },

    "category": {
      "enum": [
        "data-visualization",
        "dashboards",
        "3d-graphics",
        "maps-geo",
        "forms-workflows",
        "media",
        "developer-tools",
        "productivity",
        "finance",
        "science",
        "games",
        "other"
      ]
    },

    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "interactive-form", "calendar", "chart", "table", "map", "3d",
          "canvas", "video", "audio", "realtime", "file-upload",
          "drag-drop", "multi-step", "text-editor"
        ]
      }
    },

    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two distinct versions. Never collapse them into one field.",
      "properties": {
        "apps_spec_version": {
          "enum": ["2026-01-26", "draft"],
          "description": "Version of the io.modelcontextprotocol/ui extension spec."
        },
        "mcp_spec_version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Version of the core MCP spec, e.g. 2026-07-28."
        }
      }
    },

    "ui_resources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ui://[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$" },
      "description": "The ui:// URIs the server declares."
    },

    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": { "type": "string" },
        "pypi": { "type": "string" },
        "docker": { "type": "string" },
        "remote_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },

    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshot": { "type": "string", "format": "uri", "pattern": "^https://" },
        "gif": { "type": "string", "format": "uri", "pattern": "^https://" },
        "demo_video": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_checked"],
      "properties": {
        "status": {
          "enum": ["probed", "source-inspected", "claimed"],
          "description": "probed = a live probe saw it. source-inspected = a human read the source. claimed = nobody checked."
        },
        "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "checked_by": { "type": "string", "maxLength": 80 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mime_type": { "const": "text/html;profile=mcp-app" },
            "tool_meta_ui": {
              "type": "boolean",
              "description": "A tool carried _meta.ui.resourceUri."
            },
            "ui_resource_count": { "type": "integer", "minimum": 0 },
            "notes": { "type": "string", "maxLength": 300 }
          }
        },
        "last_failure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "reason": { "type": "string", "maxLength": 300 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "probed" } }, "required": ["status"] },
          "then": {
            "required": ["evidence"],
            "properties": {
              "evidence": { "required": ["mime_type", "tool_meta_ui"] }
            }
          }
        }
      ]
    },

    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 30 }
    }
  }
}

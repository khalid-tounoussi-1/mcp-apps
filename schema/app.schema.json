{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/khalid-tounoussi-1/mcp-apps/main/schema/app.schema.json",
  "title": "MCP App entry",
  "description": "One MCP App: a ui:// resource plus the tool that opens it. A server shipping several UI resources contributes several entries. Source of truth lives in apps/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "category", "ui_resource", "server", "verification"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Kebab-case, MUST equal the filename without .json. Name the app, not the repo."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "The app's name, e.g. \"Firebase Init UI\", not \"firebase-tools\"."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "One sentence saying what the user can do in the UI. Name the interaction."
    },

    "ui_resource": {
      "type": "string",
      "pattern": "^ui://[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$",
      "description": "The ui:// URI this app is served at."
    },
    "tool": {
      "type": "string",
      "maxLength": 80,
      "description": "Name of the tool whose _meta.ui.resourceUri points at ui_resource."
    },

    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_url"],
      "description": "The MCP server this app ships in. Several apps may share one server.",
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "repo_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "author": { "type": "string", "maxLength": 80 },
        "license": { "type": "string", "maxLength": 40 },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "npm": { "type": "string" },
            "pypi": { "type": "string" },
            "docker": { "type": "string" },
            "go": { "type": "string" },
            "remote_url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      }
    },

    "availability": {
      "type": "string",
      "maxLength": 120,
      "description": "What a user needs to do before the UI renders, when it is not on by default. E.g. \"behind experiment flag: mcpapps\"."
    },

    "category": {
      "enum": [
        "data-visualization",
        "dashboards",
        "3d-graphics",
        "maps-geo",
        "forms-workflows",
        "media",
        "developer-tools",
        "productivity",
        "finance",
        "science",
        "games",
        "other"
      ]
    },

    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "interactive-form", "calendar", "chart", "table", "map", "3d",
          "canvas", "video", "audio", "realtime", "file-upload",
          "drag-drop", "multi-step", "text-editor",
          "also-openai-widget"
        ]
      },
      "description": "also-openai-widget marks a tool that declares openai/outputTemplate alongside _meta.ui, so it works in both ecosystems."
    },

    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two distinct versions. Never collapse them into one field.",
      "properties": {
        "apps_spec_version": { "enum": ["2026-01-26", "draft"] },
        "mcp_spec_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },

    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshot": { "type": "string", "format": "uri", "pattern": "^https://" },
        "gif": { "type": "string", "format": "uri", "pattern": "^https://" },
        "demo_video": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_checked"],
      "properties": {
        "status": {
          "enum": ["probed", "source-inspected", "claimed"],
          "description": "probed = a live probe saw it. source-inspected = a human read the source. claimed = nobody checked."
        },
        "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "checked_by": { "type": "string", "maxLength": 80 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mime_type": { "const": "text/html;profile=mcp-app" },
            "tool_meta_ui": { "type": "boolean" },
            "resource_path": {
              "type": "string",
              "maxLength": 200,
              "description": "Repo-relative file declaring the resource, for source-inspected entries."
            },
            "tool_path": {
              "type": "string",
              "maxLength": 200,
              "description": "Repo-relative file where the tool carries _meta.ui.resourceUri."
            },
            "notes": { "type": "string", "maxLength": 300 }
          }
        },
        "last_failure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "reason": { "type": "string", "maxLength": 300 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "probed" } }, "required": ["status"] },
          "then": {
            "required": ["evidence"],
            "properties": { "evidence": { "required": ["mime_type", "tool_meta_ui"] } }
          }
        }
      ]
    },

    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 30 }
    }
  }
}
